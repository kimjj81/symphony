<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.studiojin.myven-nats-tunnel</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-o</string>
    <string>ServerAliveInterval=30</string>
    <string>-o</string>
    <string>ServerAliveCountMax=3</string>
    <string>oracle</string>
    <string>kubectl -n webhook-relay port-forward --address 100.77.171.83 svc/nats 24222:4222</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/kimjeongjin/Library/Logs/myven-nats-tunnel.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/kimjeongjin/Library/Logs/myven-nats-tunnel.err.log</string>
</dict>
</plist>
